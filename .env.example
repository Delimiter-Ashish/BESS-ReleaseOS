# Copy to .env.local (never commit real keys). All values are read server-side only.

# --- AI provider ---
# openai | anthropic | rules   (unset: openai if OPENAI_API_KEY is set, else rules)
AI_PROVIDER=openai
OPENAI_API_KEY=
# Vision-capable model used via the Responses API (PDF input_file + strict JSON schema)
OPENAI_MODEL=gpt-5.5
OPENAI_TIMEOUT_MS=90000
OPENAI_MAX_OUTPUT_TOKENS=12000
# Optional: only used when AI_PROVIDER=anthropic (Kaushik's original extractor)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Demo session signing (HMAC). Unset → random per-process key (sessions end on restart). ---
SESSION_SECRET=change-me-to-a-long-random-string

# --- Upload limits ---
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=40

# Optional: absolute URL used in site QR codes
PUBLIC_BASE_URL=
