{
  "name": "@releaseos/release-core",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic in-memory document intelligence and immutable release engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "fixtures",
    "demo",
    "LEGACY.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "demo": "npm run build && node demo/scenario.mjs"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "typescript": "5.8.2"
  },
  "dependencies": {
    "fflate": "0.8.3"
  }
}
